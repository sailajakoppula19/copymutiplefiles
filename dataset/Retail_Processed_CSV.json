{
	"name": "Retail_Processed_CSV",
	"properties": {
		"linkedServiceName": {
			"referenceName": "ADLStorage",
			"type": "LinkedServiceReference"
		},
		"parameters": {
			"pfilename": {
				"type": "string",
				"defaultValue": "@item().name"
			}
		},
		"annotations": [],
		"type": "DelimitedText",
		"typeProperties": {
			"location": {
				"type": "AzureBlobFSLocation",
				"fileName": "@dataset().pFileName",
				"folderPath": "processed",
				"fileSystem": "warehouseproject"
			},
			"columnDelimiter": ",",
			"escapeChar": "\\",
			"firstRowAsHeader": true,
			"quoteChar": "\""
		},
		"schema": []
	}
}